'''Snakemake workflow to analyse SNP call as a function of cell count.

This workflow generated subsampled datasets and calls variants on them, in order to correlate cell count with variant calling performance.
The goal is to show that variability in SNP calling is driven by the cell count, and no biases are introduced by the subsampling procedure.

Usage:
    # Run all experiments
    snakemake --cores 4

    # Dry run to see what would be executed
    snakemake -n

    # Generate DAG visualization
    snakemake --dag | dot -Tpng > dag.png

    # Run specific experiment
    snakemake results/exp_proc0.1_meas0.5.parquet
'''

import itertools
from pathlib import Path

from mutation_call_variability import commodity

# Load configuration
configfile: 'workflow/config/params.yaml'

# Extract parameter grid
all_files = commodity.load_lookup_table(config['lookup_table'])
IN_DIR = Path(config['input_directory'])
OUT_DIR = output_directory = Path(config['output_directory'])
all_files.append([OUT_DIR / 'S1.full.filtered_variants.csv', OUT_DIR / 'S2.full.filtered_variants.csv', OUT_DIR / 'S3.full.filtered_variants.csv'])
all_files.append(OUT_DIR / 'jaccard_indices.tsv')

# =============================================================================
# Define functions to condition inputs and parameters on wildcards
# =============================================================================

def get_loom_file(wildcards):
    paper2datasetPID = {'S1': 'GFB-4397_GFB-4401', 'S2': 'GFB-4395_GFB-4399', 'S3': 'GFB-4396_GFB-4400'}
    datasetPID = paper2datasetPID.get(wildcards.samplePID)
    return IN_DIR / f'{datasetPID}_out' / 'dna' / 'results' / f'{datasetPID}.cells.loom'


def get_mem_mb(wildcards, attempt):
    return  50000 * 2**(attempt-1)  # double memory for each retry

# =============================================================================
# Target rule: what we want to build
# =============================================================================

rule all:
    """Build all outputs: experiment results and final report."""
    input:
        all_files,


# =============================================================================
# Experiment rules
# =============================================================================

rule subsample_loom:
    '''Based on the lookup table, subsample the loom files to the desired cell counts.'''
    input:
        get_loom_file
    output:
        OUT_DIR
        / '{samplePID}.{cell_count}.{hash}.loom'
    resources:
        mem_mb_per_cpu = get_mem_mb,
        mem_mb = 5000,
        runtime = 240,
    threads: 1
    run:
        from mutation_call_variability import subsample_loom
        subsample_loom.subsample_loom(input[0], output[0])


rule mosaic_subsample:
    input:
        loom = OUT_DIR
        / '{samplePID}.{cell_count}.{hash}.loom'
    output:
        var = OUT_DIR / '{samplePID}.{cell_count}.{hash}.filtered_variants.csv',
        gt = OUT_DIR / '{samplePID}.{cell_count}.{hash}.filtered_variants_gt.csv',
    # conda: os.path.join(ENV_DIR, 'analysis.yaml')
    threads: 1
    resources:
        mem_mb_per_cpu = get_mem_mb,
        runtime = 60,
    params:
        minGQ = config.get('mosaic', {}).get('minGQ', 30),
        minDP = config.get('mosaic', {}).get('minDP', 10),
        minVAF = config.get('mosaic', {}).get('minVAF', 0.2),
        minVarGeno = config.get('mosaic', {}).get('minVarGeno', 0.5),
        minCellGeno = config.get('mosaic', {}).get('minCellGeno', 0.5),
        minMutated = config.get('mosaic', {}).get('minMutated', 50),
        maxRefVAF = config.get('mosaic', {}).get('maxRefVAF', 0.05),
        minHomVAF = config.get('mosaic', {}).get('minHomVAF', 0.95),
        minHetVAF = config.get('mosaic', {}).get('minHetVAF', 0.35),
        proximity = config.get('mosaic', {}).get('proximity', '25 50 100 200')
    shell:
        '''
        python src/mutation_call_variability/mosaic_processing.py \
            -i {input.loom} \
            -o {output.var} \
            --minGQ {params.minGQ} \
            --minDP {params.minDP} \
            --minVAF {params.minVAF} \
            --minVarGeno {params.minVarGeno} \
            --minCellGeno {params.minCellGeno} \
            --minMutated {params.minMutated} \
            --max_ref_VAF {params.maxRefVAF} \
            --min_hom_VAF {params.minHomVAF} \
            --min_het_VAF {params.minHetVAF} \
            --proximity {params.proximity}
        '''


rule mosaic_full:
    input:
        loom = get_loom_file,
    output:
        var = OUT_DIR / '{samplePID}.full.filtered_variants.csv',
        gt = OUT_DIR / '{samplePID}.full.filtered_variants_gt.csv',
    threads: 1
    resources:
        mem_mb_per_cpu = 49152,
        runtime = 60,
    params:
        minGQ = config.get('mosaic', {}).get('minGQ', 30),
        minDP = config.get('mosaic', {}).get('minDP', 10),
        minVAF = config.get('mosaic', {}).get('minVAF', 0.2),
        minVarGeno = config.get('mosaic', {}).get('minVarGeno', 0.5),
        minCellGeno = config.get('mosaic', {}).get('minCellGeno', 0.5),
        minMutated = config.get('mosaic', {}).get('minMutated', 50),
        maxRefVAF = config.get('mosaic', {}).get('maxRefVAF', 0.05),
        minHomVAF = config.get('mosaic', {}).get('minHomVAF', 0.95),
        minHetVAF = config.get('mosaic', {}).get('minHetVAF', 0.35),
        proximity = config.get('mosaic', {}).get('proximity', '25 50 100 200')
    shell:
        '''
        python src/mutation_call_variability/mosaic_processing.py \
            -i {input.loom} \
            -o {output.var} \
            --minGQ {params.minGQ} \
            --minDP {params.minDP} \
            --minVAF {params.minVAF} \
            --minVarGeno {params.minVarGeno} \
            --minCellGeno {params.minCellGeno} \
            --minMutated {params.minMutated} \
            --max_ref_VAF {params.maxRefVAF} \
            --min_hom_VAF {params.minHomVAF} \
            --min_het_VAF {params.minHetVAF} \
            --proximity {params.proximity}
        '''

rule compute_jaccard_indices:
    input:
        lookup_table = config['lookup_table'],
        full_variant_sets = [
            OUT_DIR / 'S1.full.filtered_variants.csv',
            OUT_DIR / 'S2.full.filtered_variants.csv',
            OUT_DIR / 'S3.full.filtered_variants.csv']
    output:
        OUT_DIR / 'jaccard_indices.tsv'
    resources:
        mem_mb_per_cpu = 5000,
        runtime = 60,
    threads: 1
    run:
        from mutation_call_variability import jaccard_index
        full_variant_sets_assignment = {'S1': input.full_variant_sets[0], 'S2': input.full_variant_sets[1], 'S3': input.full_variant_sets[2]}

        output_table = jaccard_index.compute_jaccard_indices(input.lookup_table, full_variant_sets_assignment)
        output_table.write_csv(output[0],separator='\t', include_header=True)